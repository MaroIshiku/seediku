# Non-secret Seediku configuration for local overrides.
# Keep credentials in private files and point the *_FILE variables at them.

TZ=Europe/Berlin
ISHIKU_APP_URL=http://localhost:8509
ISHIKU_LOG_LEVEL=info
ISHIKU_SETUP_SECRET_FILE=./secrets/setup_secret.txt

QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD_FILE=./secrets/qbittorrent_password.txt
QBITTORRENT_WEBUI_URL=http://localhost:8185

# Public IP lookup discloses the requesting address to this HTTPS service.
SEEDIKU_PUBLIC_IP_ENDPOINTS=https://api.ipify.org?format=json
# The Gluetun Compose overlay sets SEEDIKU_VPN_IP_URL.
